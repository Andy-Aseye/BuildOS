# Copy this file to: apps/api/.env
# The API only reads apps/api/.env (not a .env at the repo root).

# --- Required (validated on startup) ---
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[ref].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[ref].supabase.co:5432/postgres"
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# URL-encode special characters in the password (e.g. $ → %24).

# If Prisma shows P1001 (can't reach db.<ref>.supabase.co:5432), your network may block IPv6 or port 5432.
# Fix: In Supabase → Database → Connection string, open "Session pooler" and copy the URI for DIRECT_URL
# (host looks like aws-0-<region>.pooler.supabase.com, port 5432). Keep DATABASE_URL as Transaction pooler :6543.

# --- Optional (defaults exist) ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- WhatsApp Cloud API (webhook: GET/POST /webhooks/whatsapp) ---
# WHATSAPP_TOKEN=           # Graph API permanent token
# WHATSAPP_PHONE_ID=        # Phone number ID from Meta app
# WHATSAPP_VERIFY_TOKEN=    # Your random string for webhook verification
# WHATSAPP_APP_SECRET=      # App secret (for X-Hub-Signature-256). Omit only in local dev (signature skipped).
# WHATSAPP_MEDIA_BUCKET=whatsapp-media  # Supabase Storage bucket for inbound media (create + allow public read if using getPublicUrl)
# PROJECT_STORAGE_BUCKET=buildos-uploads  # Dashboard uploads (drawings, progress-report PDFs). Falls back to WHATSAPP_MEDIA_BUCKET, then buildos-uploads.

# OPENAI_API_KEY=sk-...     # Whisper + GPT-4o-mini classification + AI diary summary + AI query bar

# JWT_SECRET=

# --- Email (Resend) ---
# RESEND_API_KEY=re_...     # Transactional email for invites and report delivery (optional)
# EMAIL_FROM="BuildOS <noreply@yourdomain.com>"  # Defaults to noreply@buildos.app

# --- Frontend (create apps/web/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:3001
